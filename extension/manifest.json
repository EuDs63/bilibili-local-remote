{
  "manifest_version": 3,
  "name": "网页视频床上遥控器",
  "version": "1.0.0",
  "description": "让手机通过局域网遥控 Edge/Chrome 中的网页视频播放器。",
  "permissions": ["tabs", "tabGroups", "windows", "alarms", "debugger", "storage"],
  "host_permissions": [
    "http://127.0.0.1:17331/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "网页视频床上遥控器",
    "default_popup": "popup.html"
  }
}
